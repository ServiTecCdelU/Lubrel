{
  "expo": {
    "name": "Leon Express",
    "slug": "app-pedidos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "servitecpedidos",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ar.com.servitec.pedidos"
    },
    "android": {
      "package": "ar.com.servitec.pedidos",
      "versionCode": 23,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0F766E",
          "defaultChannel": "pedidos"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para escanear el QR de tu distribuidora y el código de barras de los productos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa para elegir la imagen del QR de tu distribuidora.",
          "cameraPermission": "La cámara se usa para escanear el QR de tu distribuidora y el código de barras de los productos.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Organización, proyecto y token por variables de entorno: SENTRY_ORG, SENTRY_PROJECT y SENTRY_AUTH_TOKEN (ver README)."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "serviteccdelu",
    "extra": {
      "appId": "leon-express",
      "router": {},
      "eas": {
        "projectId": "7d7ecc25-0858-4614-8d2a-d54dd7e4460b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7d7ecc25-0858-4614-8d2a-d54dd7e4460b"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
